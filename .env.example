# ---------------------------------------------------------------------------
# TeamFlow – konfigurace prostředí
# Zkopírujte do `.env` (`cp .env.example .env`). Soubor `.env` necommitujte.
# ---------------------------------------------------------------------------

# --- Docker Compose ---------------------------------------------------------
POSTGRES_USER=teamflow
# V produkci nastavte silné náhodné heslo.
POSTGRES_PASSWORD=teamflow
POSTGRES_DB=teamflow
# Port PostgreSQL na hostiteli (vystavený jen na 127.0.0.1).
POSTGRES_PORT=5433
# Port webové aplikace na hostiteli.
WEB_PORT=8080

# --- API --------------------------------------------------------------------
# local | test | production – `production` zakazuje demo seed.
APP_ENV=local
LOG_LEVEL=info
PORT=4000
HOST=0.0.0.0
# Připojení k databázi pro lokální vývoj mimo Docker (`npm run dev`).
DATABASE_URL=postgresql://teamflow:teamflow@127.0.0.1:5433/teamflow?schema=public
# Databáze pro integrační testy (vytvoří se automaticky, obsah se maže).
DATABASE_URL_TEST=postgresql://teamflow:teamflow@127.0.0.1:5433/teamflow_test?schema=public
# Veřejná adresa frontendu – povolený Origin pro zápisové požadavky (CSRF ochrana).
# Více adres oddělte čárkou.
APP_ORIGIN=http://localhost:8080,http://localhost:5173
# V produkci za HTTPS nastavte na true (cookie s příznakem Secure).
COOKIE_SECURE=false
# Za reverzní proxy (nginx) nastavte true, aby se správně určovala IP klienta.
TRUST_PROXY=false
# Při startu kontejneru naplnit prázdnou databázi demo daty (jen mimo produkci).
SEED_ON_START=true
